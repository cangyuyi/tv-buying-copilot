      "check_points": ["route_correct", "mentions_delivery_time"]
    },
    {
      "id": "N13",
      "category": "normal",
      "input": "挂装收费吗？65寸的",
      "expected_route": "fulfillment",
      "expected_slots": {"size": 65},
      "expected_behavior": "说明挂装费用，按尺寸报价",
      "check_points": ["route_correct", "mentions_wall_mount", "size_specific_price"]
    },
    {
      "id": "N14",
      "category": "normal",
      "input": "预算8000，75寸，客厅用，看电影玩游戏",
      "expected_route": "product",
      "expected_slots": {"budget": 8000, "size": 75, "use_cases": ["客厅", "电影", "游戏"]},
      "expected_behavior": "大屏高预算推荐，注意库存状态",
      "check_points": ["route_correct", "large_size", "budget_respected"]
    },
    {
      "id": "N15",
      "category": "normal",
      "input": "租房过渡用，小一点的，1500以内",
      "expected_route": "product",
      "expected_slots": {"budget": 1500, "use_cases": ["租房"]},
      "expected_behavior": "识别租房用途，推荐小尺寸低价型号",
      "check_points": ["route_correct", "rental_use_case", "low_budget"]
    },
    {
      "id": "B01",
      "category": "boundary",
      "input": "不玩游戏，只追剧，55寸，3000以内",
      "expected_route": "product",
      "expected_slots": {"budget": 3000, "size": 55, "use_cases": ["追剧"]},
      "expected_behavior": "否定句处理：排除游戏用途，只保留追剧",
      "check_points": ["route_correct", "negation_handled", "no_game_in_use_cases"]
    },
    {
      "id": "B02",
      "category": "boundary",
      "input": "观看距离2米5，预算4000，追剧",
      "expected_route": "product",
      "expected_slots": {"budget": 4000, "distance": 2.5, "use_cases": ["追剧"]},
      "expected_behavior": "口语距离'2米5'正确解析为2.5米",
      "check_points": ["route_correct", "colloquial_distance_parsed"]
    },
    {
      "id": "B03",
      "category": "boundary",
      "input": "3k预算，65寸，看电影",
      "expected_route": "product",
      "expected_slots": {"budget": 3000, "size": 65, "use_cases": ["电影"]},
      "expected_behavior": "缩写'3k'正确解析为3000",
      "check_points": ["route_correct", "k_abbreviation_parsed"]
    },
    {
      "id": "B04",
      "category": "boundary",
      "input": "预算1万，要最好的电视",
      "expected_route": "product",
      "expected_slots": {"budget": 10000},
      "expected_behavior": "高预算推荐，不编造超出商品库的型号",
      "check_points": ["route_correct", "high_budget", "no_hallucination"]
    },
    {
      "id": "B05",
      "category": "boundary",
      "input": "1000块以下能买到电视吗",
      "expected_route": "product",
      "expected_slots": {"budget": 1000},
      "expected_behavior": "低预算可能无候选，给出放宽建议",
      "check_points": ["route_correct", "low_budget_handled", "suggestion_when_no_match"]
    },
    {
      "id": "B06",
      "category": "boundary",
      "input": "随便推荐个电视呗",
      "expected_route": "clarify",
      "expected_slots": {},
      "expected_behavior": "模糊需求，引导澄清",
      "check_points": ["route_correct", "asks_clarification"]
    },
    {
      "id": "B07",
      "category": "boundary",
      "input": "预算4k，打游戏，要高刷",
      "expected_route": "clarify",
      "expected_slots": {"budget": 4000, "use_cases": ["游戏"]},
      "expected_behavior": "缺尺寸/距离，先澄清",
      "check_points": ["route_correct", "gaming_use_case", "asks_size"]
    },
    {
      "id": "A01",
      "category": "abnormal",
      "input": "我要退货，电视屏幕碎了",
      "expected_route": "handoff",
      "expected_slots": {},
      "expected_behavior": "售后高风险，强制转人工，不自行处理",
      "check_points": ["route_correct", "handoff_triggered", "no_self_processing"]
    },
    {
      "id": "A02",
      "category": "abnormal",
      "input": "我要投诉你们客服，给我转接",
      "expected_route": "handoff",
      "expected_slots": {},
      "expected_behavior": "投诉高风险，强制转人工",
      "check_points": ["route_correct", "handoff_triggered"]
    },
    {
      "id": "A03",
      "category": "abnormal",
      "input": "今天天气怎么样",
      "expected_route": "fallback",
      "expected_slots": {},
      "expected_behavior": "非相关问题，兜底回复并引导到电视导购",
      "check_points": ["route_correct", "fallback_response", "guides_to_tv"]
