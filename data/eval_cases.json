{
  "version": "1.0",
  "description": "电视选购 Copilot Multi-Agent 导购系统评测集，按正常/边界/异常三类分层",
  "pass_thresholds": {
    "normal": 0.9,
    "boundary": 0.5,
    "abnormal": 0.99
  },
  "cases": [
    {
      "id": "N01",
      "category": "normal",
      "input": "预算4000，客厅2.5米，追剧看电影，推荐个电视",
      "expected_route": "product",
      "expected_slots": {"budget": 4000, "distance": 2.5, "use_cases": ["追剧", "电影", "客厅"]},
      "expected_behavior": "返回3款以内推荐，价格不超预算，包含引用标注",
      "check_points": ["route_correct", "slots_extracted", "budget_respected", "has_citation"]
    },
    {
      "id": "N02",
      "category": "normal",
      "input": "现在有什么优惠活动？",
      "expected_route": "promotion",
      "expected_slots": {},
      "expected_behavior": "列出当前促销活动，包含优惠叠加说明",
      "check_points": ["route_correct", "lists_promotions"]
    },
    {
      "id": "N03",
      "category": "normal",
      "input": "配送和安装怎么收费？",
      "expected_route": "fulfillment",
      "expected_slots": {},
      "expected_behavior": "说明配送时效和安装费用",
      "check_points": ["route_correct", "mentions_delivery", "mentions_installation"]
    },
    {
      "id": "N04",
      "category": "normal",
      "input": "推荐个电视",
      "expected_route": "clarify",
      "expected_slots": {},
      "expected_behavior": "信息不足，先问预算",
      "check_points": ["route_correct", "asks_budget_first"]
    },
    {
      "id": "N05",
      "category": "normal",
      "input": "三千预算，55寸，追剧用",
      "expected_route": "product",
      "expected_slots": {"budget": 3000, "size": 55, "use_cases": ["追剧"]},
      "expected_behavior": "中文数字预算正确识别，返回推荐",
      "check_points": ["route_correct", "chinese_number_parsed", "budget_respected"]
    },
    {
      "id": "N06",
      "category": "normal",
      "input": "客厅3米，买多大的电视合适？",
      "expected_route": "clarify",
      "expected_slots": {"distance": 3.0},
      "expected_behavior": "提取距离，但缺预算和用途，继续澄清",
      "check_points": ["route_correct", "distance_parsed", "asks_missing_slots"]
    },
    {
      "id": "N07",
      "category": "normal",
      "input": "预算5000，玩PS5，要120Hz以上，65寸",
      "expected_route": "product",
      "expected_slots": {"budget": 5000, "size": 65, "use_cases": ["游戏"], "min_refresh": 120},
      "expected_behavior": "筛选120Hz以上游戏电视，返回候选",
      "check_points": ["route_correct", "refresh_filtered", "gaming_use_case"]
    },
    {
      "id": "N08",
      "category": "normal",
      "input": "给老人买个电视，操作简单的，2000左右，55寸",
      "expected_route": "product",
      "expected_slots": {"budget": 2000, "size": 55, "use_cases": ["老人"]},
      "expected_behavior": "识别老人用途，推荐操作简单的型号",
      "check_points": ["route_correct", "elderly_use_case", "budget_respected"]
